{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<script
  src="{{ 'recently-viewed-section.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<wearox-recently-viewed
  class="section section--{{ section.settings.section_width }} recently-viewed spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-section-id="{{ section.id }}"
  data-current-product-id="{{ product.id | default: '' }}"
  data-max-products="{{ section.settings.max_products }}"
  {% unless request.page_type == 'search' and search.performed %}hidden{% endunless %}
  {{ section.shopify_attributes }}
>
  <div class="recently-viewed__header">
    <h2 class="recently-viewed__heading {{ section.settings.heading_preset }}">
      {{ section.settings.heading | escape }}
    </h2>
    <button
      type="button"
      class="button button-unstyled recently-viewed__clear"
      data-recently-viewed-clear
    >
      {{ 'actions.clear' | t }}
    </button>
  </div>

  <ul
    class="recently-viewed__grid list-unstyled"
    data-recently-viewed-grid
    role="list"
  >
    {%- if request.page_type == 'search' and search.performed -%}
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          <li
            class="recently-viewed__item"
            data-recently-viewed-item
            data-product-id="{{ item.id }}"
          >
            {% render 'resource-card',
              resource_type: 'product',
              resource: item,
              image_width: 800,
              image_hover: true,
              image_aspect_ratio: '4 / 5',
              product_view_context: 'recently-viewed'
            %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</wearox-recently-viewed>

{% stylesheet %}
  .recently-viewed {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 24px);
  }

  .recently-viewed[hidden] {
    display: none;
  }

  .recently-viewed__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-md, 16px);
  }

  .recently-viewed__heading {
    margin: 0;
  }

  .recently-viewed__clear {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .recently-viewed__grid {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-md, 16px);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently viewed products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECENTLY VIEWED"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Recently viewed products"
    }
  ]
}
{% endschema %}
